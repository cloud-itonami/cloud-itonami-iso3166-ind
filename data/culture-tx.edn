#:culture{:id "ind.dish.biryani", :name "Biryani", :country "IND", :kind :dish, :summary "Mixed rice dish of rice with meat, seafood or vegetables and spices, originating from South Asia; whether the modern dish was created in Mughal-era India or derives from Persian pilau is debated.", :url "https://en.wikipedia.org/wiki/Biryani", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "ind.dish.masala-dosa", :name "Masala dosa", :country "IND", :kind :dish, :summary "Dish of South India consisting of a savoury dosa crepe stuffed with a spiced potato stir fry, popular as a breakfast item.", :url "https://en.wikipedia.org/wiki/Masala_dosa", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:url "https://en.wikipedia.org/wiki/Butter_chicken", :id "ind.dish.butter-chicken", :kind :dish, :name-local "Murgh makhani", :country "IND", :retrieved-at "2026-07-17", :summary "Curry of chicken in a spiced tomato-and-butter gravy, invented by Indian chefs Kundan Lal Gujral and Kundan Lal Jaggi and popularized at the Moti Mahal restaurant in Delhi in the 1950s.", :name "Butter chicken", :url-provenance :wikipedia-en}
#:culture{:id "ind.beverage.masala-chai", :name "Masala chai", :country "IND", :kind :beverage, :summary "Popular Indian beverage of black tea brewed in milk and water with aromatic spices such as cardamom, ginger and cinnamon, sweetened with sugar.", :url "https://en.wikipedia.org/wiki/Masala_chai", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "ind.beverage.lassi", :name "Lassi", :country "IND", :kind :beverage, :summary "Yogurt-based beverage with a smoothie-like consistency, originating from Punjab in the Indian subcontinent.", :url "https://en.wikipedia.org/wiki/Lassi", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "ind.product.darjeeling-tea", :name "Darjeeling tea", :country "IND", :kind :product, :summary "Black tea from the Darjeeling and Kalimpong districts of West Bengal, India, noted for its muscatel flavor; a registered geographical indication since 2004 with EU protected geographical indication status since 2011.", :url "https://en.wikipedia.org/wiki/Darjeeling_tea", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "ind.craft.banarasi-sari", :name "Banarasi sari", :country "IND", :kind :craft, :summary "Handwoven silk textile from Varanasi, India, distinguished by intricate gold and silver brocade; weaver associations secured geographical indication rights for Banaras brocades and saris in 2009.", :url "https://en.wikipedia.org/wiki/Banarasi_sari", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "ind.festival.diwali", :name "Diwali", :country "IND", :kind :festival, :summary "Hindu festival of lights symbolising the victory of light over darkness, celebrated primarily in India and also in Jain, Sikh and some Buddhist traditions.", :url "https://en.wikipedia.org/wiki/Diwali", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "ind.festival.kumbh-mela", :name "Kumbh Mela", :country "IND", :kind :festival, :summary "Hindu pilgrimage celebrated every four to twelve years at four sacred river sites in India, drawing millions of devotees for ritual bathing; inscribed as UNESCO intangible cultural heritage in 2017.", :url "https://en.wikipedia.org/wiki/Kumbh_Mela", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "ind.heritage.taj-mahal", :name "Taj Mahal", :country "IND", :kind :heritage, :summary "17th-century ivory-white marble mausoleum in Agra built by Mughal emperor Shah Jahan for his wife Mumtaz Mahal; a UNESCO World Heritage Site designated in 1983.", :url "https://en.wikipedia.org/wiki/Taj_Mahal", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
